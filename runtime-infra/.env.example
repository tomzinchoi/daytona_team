# Server credentials only. Never use NEXT_PUBLIC_ / VITE_ prefixes.
HOST=127.0.0.1
PORT=3001
# Required when exposing the server on a non-loopback address.
RUNTIME_API_TOKEN=

DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
# Immutable snapshot ID created from infra/Dockerfile, required for benchmarks.
DAYTONA_SNAPSHOT=
BENCHMARK_TIMEOUT_SECONDS=300
BENCHMARK_MAX_TOKENS=512
DAYTONA_PROVISION_TIMEOUT_SECONDS=120

# Nosana is a future adapter. Supplying a key alone does not make it LIVE.
NOSANA_API_KEY=
NOSANA_MARKET_ID=

# Promotion only. Sandbox is the default; no production DNS writes implemented.
DNSIMPLE_TOKEN=
DNSIMPLE_ACCOUNT_ID=
DNSIMPLE_ENVIRONMENT=sandbox

# Used only by snapshot:create. Set an immutable image digest.
BENCHMARK_IMAGE=
BENCHMARK_SNAPSHOT_NAME=benchmark-lab-v1
